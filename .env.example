# 로컬 개발용 환경변수 예시
# cp .env.example .env 후 값을 채운다. (.env는 커밋하지 않는다)

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# 인증 서버와 같은 값 (32바이트 이상)
JWT_SECRET=change-me-same-secret-as-auth-backend-at-least-32-bytes
JWT_ISSUER=auth-backend

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
